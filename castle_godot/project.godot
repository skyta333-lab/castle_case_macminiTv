config_version=5

[application]

config/name="Fairytale Castle"
config/description="迪士尼风格童话城堡：由 Blender 程序化生成 castle_ref_model.glb，在 Godot 中搭建演示场景。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
